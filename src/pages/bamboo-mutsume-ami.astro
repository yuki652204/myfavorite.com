    .cta-block { margin: 3rem 0 0; padding: 1.5rem; background: var(--paper-warm); border: 0.5px solid var(--border); border-radius: 6px; }
    .cta-block p { font-family: var(--sans); font-size: 14px; color: var(--ink-light); line-height: 1.8; margin: 0; }
    .cta-block a { color: var(--accent); text-decoration: none; border-bottom: 0.5px solid var(--accent-light); padding-bottom: 1px; }

    /* TAGS */
    .tag-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 2.5rem; }
