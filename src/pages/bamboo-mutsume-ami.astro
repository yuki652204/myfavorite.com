    }
    html { scroll-behavior: smooth; }
    body {
      background: var(--paper);
      color: var(--ink);
      font-family: var(--serif-ja);
      font-size: 16px;
      line-height: 2;
      -webkit-font-smoothing: antialiased;
    }

    /* HEADER */
    .site-header {
      padding: 1.5rem 2rem;
      border-bottom: 0.5px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
