    .lang-toggle { display: flex; gap: 0; border: 0.5px solid var(--border); border-radius: 4px; overflow: hidden; }
    .lang-toggle button { background: transparent; border: none; padding: 6px 14px; font-family: var(--sans); font-size: 12px; cursor: pointer; color: var(--ink-muted); transition: background 0.2s, color 0.2s; }
    .lang-toggle button.active { background: var(--ink); color: var(--paper); }

    /* HERO */
    .hero {
      position: relative;
      width: 100%;
      height: clamp(300px, 50vw, 520px);
      overflow: hidden;
    }
    .hero img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
    .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 30%, rgba(26,24,20,0.55) 100%); }
    .hero-title-block {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      text-align: center;
      z-index: 3;
      width: 90%;
    }
    .hero-series { font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em; color: rgba(247,244,239,0.7); text-transform: uppercase; margin-bottom: 0.5rem; }
    .hero-h1-ja { font-family: var(--serif-ja); font-size: clamp(20px, 3.5vw, 32px); font-weight: 500; color: #f7f4ef; line-height: 1.5; margin-bottom: 0.25rem; }
