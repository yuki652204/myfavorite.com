    /* ARTICLE */
    .article-container { max-width: 720px; margin: 0 auto; padding: 4rem 2rem 6rem; }
    .lang-ja, .lang-en { display: block; }
    .lang-ja.hidden, .lang-en.hidden { display: none; }

    /* TYPOGRAPHY */
    .article-lead { font-size: 15px; color: var(--ink-muted); border-left: 2px solid var(--accent-light); padding-left: 1.25rem; margin-bottom: 3rem; line-height: 2; border-radius: 0; }
    .section-label { font-family: var(--sans); font-size: 11px; letter-spacing: 0.12em; color: var(--accent); margin: 3rem 0 1rem; display: flex; align-items: center; gap: 10px; }
